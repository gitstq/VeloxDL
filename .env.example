# ============================================================
# VeloxDL 环境变量说明
#
# 使用方式：
#   1. cp .env.example .env
#   2. 按需修改下面的值
#   3. 加载后运行：set -a && source .env && set +a && veloxdl <URL>
#
# 说明：命令行参数优先级高于环境变量。
#       即显式传入 -n 32 会覆盖 VELOXDL_MAX_CONNS。
# ============================================================

# ---------- 并发 ----------

# 最大并发连接数。默认 16。
# 建议值：家庭宽带 8~16，服务器/教育网 32~64。
# 过高会触发对端限流，反而变慢。
VELOXDL_MAX_CONNS=16

# 分片最小尺寸（字节）。默认 1048576（1 MiB）。
# 文件越大，这个值可以适当调大以减少请求数。
VELOXDL_CHUNK_SIZE=1048576

# ---------- 网络 ----------

# 单文件限速，支持 500K / 2M / 10M 这类写法，也支持纯字节数。
# 留空或设为 0 表示不限速。
# 适合下载时不想占满带宽、影响会议/游戏的场景。
VELOXDL_RATE_LIMIT=

# 单个分片的请求超时，支持 30s / 2m 这类 Go 时长写法。默认 60s。
VELOXDL_TIMEOUT=60s

# 单个分片的最大重试次数。默认 5。
VELOXDL_RETRIES=5

# 自定义 User-Agent。留空则使用 VeloxDL/版本号。
# 部分站点会校验 UA，遇到 403 时可尝试改成浏览器 UA。
VELOXDL_USER_AGENT=

# ---------- 输出 ----------

# 设为 1 时开启静默模式：只输出最终文件路径，方便在脚本里使用。
# 例如：OUT=$(VELOXDL_QUIET=1 veloxdl https://example.com/a.iso)
VELOXDL_QUIET=0

# ---------- 标准代理变量（由 Go 标准库直接支持）----------
# 如需走代理，设置下面这些即可，VeloxDL 会自动读取：
#
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
